# Local Android SDK configuration. Copy this file to local.properties.
# local.properties is ignored by Git.
# sdk.dir=C\:\\Users\\your-name\\AppData\\Local\\Android\\Sdk

# Optional: sign release APKs with your own keystore.
# KEYSTORE_PATH=C\:\\path\\to\\nexus-release.jks
# KEYSTORE_PASSWORD=your_keystore_password
# KEY_ALIAS=nexus_release_alias
# KEY_PASSWORD=your_key_password
